{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "scripts"],
  // preview-questions.ts imports from src/, which is compiled under
  // tsconfig.app.json's bundler resolution (extension-less relative
  // imports). Pulling it into this nodenext project would force
  // explicit .js extensions across the whole engine graph it touches, so
  // it's excluded here and relies on `tsx` (type-stripping only) to run,
  // same as the other scripts in this directory.
  "exclude": ["scripts/preview-questions.ts"]
}
